<?xml version="1.0" encoding="UTF-8"?>
<!--
  Headless syncthis for one user, as a launchd user agent.

    mkdir -p ~/Library/LaunchAgents
    cp packaging/launchd/com.github.wesbragagt.syncthis.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.github.wesbragagt.syncthis.plist

  A LaunchAgent runs as the user who loads it, so the daemon owns the data
  directory it reads and the files it synchronizes. Replace USER below with
  that user's short name: launchd does not expand ~ or $HOME here.

  The daemon must already have an identity: run `syncthis init` once first.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.wesbragagt.syncthis</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/syncthis</string>
    <string>daemon</string>
    <string>run</string>
  </array>

  <!-- The data directory the daemon opens: identity, config.json, state.db
       and the control socket. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>SYNCTHIS_DATA_DIR</key>
    <string>/Users/USER/Library/Application Support/syncthis</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <!-- A daemon that exits for any reason comes back. ThrottleInterval is the
       floor launchd puts between restarts. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <!-- SIGTERM is what `daemon run` shuts down cleanly on. -->
  <key>ExitTimeOut</key>
  <integer>30</integer>

  <key>WorkingDirectory</key>
  <string>/Users/USER</string>
  <key>StandardOutPath</key>
  <string>/Users/USER/Library/Logs/syncthis.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/syncthis.log</string>
</dict>
</plist>
